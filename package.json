{
  "name": "@local/dsh-music",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "Native-feeling local hi-res music player for the DeepSeek Harness: mpv engine, library index, mini player and Now Playing.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/host/*.js",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && npm test",
    "test": "node --test \"test/*.test.mjs\"",
    "test:l2": "node --test \"test/integration/*.test.mjs\"",
    "smoke": "node scripts/service-smoke.mjs",
    "test:live": "node scripts/playback-test.mjs",
    "perf": "node scripts/loadtest.mjs",
    "test:stress": "node scripts/stress-model.mjs"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
