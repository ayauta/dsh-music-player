{
  "name": "@ayauta/dsh-music-player",
  "version": "1.8.1",
  "type": "module",
  "description": "Native-feeling local hi-res music player for the DeepSeek Harness: mpv engine, library index, mini player and Now Playing.",
  "license": "MIT",
  "author": "ayauta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayauta/dsh-music-player.git"
  },
  "homepage": "https://github.com/ayauta/dsh-music-player#readme",
  "bugs": {
    "url": "https://github.com/ayauta/dsh-music-player/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "music",
    "mpv",
    "hi-res"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/host/*.js",
    "lib/shared/*.js",
    "locale/*.json",
    "icon.svg",
    "NOTICE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "check": "node scripts/syntax-check.mjs && npm test",
    "test": "node --test \"test/*.test.mjs\"",
    "test:repeat": "node scripts/test-repeat.mjs",
    "syntax": "node scripts/syntax-check.mjs",
    "inline:playhead": "node scripts/inline-playhead.mjs --write",
    "test:l2": "node --test \"test/integration/*.test.mjs\"",
    "smoke": "node scripts/service-smoke.mjs",
    "test:live": "node scripts/playback-test.mjs",
    "perf": "node scripts/loadtest.mjs",
    "test:stress": "node scripts/stress-model.mjs"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
